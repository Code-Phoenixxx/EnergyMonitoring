# Environment Configuration for Energy Monitoring System

# Database Settings (TimescaleDB / PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_123
POSTGRES_DB=energy_monitoring
DATABASE_HOST=timescaledb
DATABASE_PORT=5432
DATABASE_URL=postgresql://postgres:postgres_password_123@timescaledb:5432/energy_monitoring

# MQTT Broker Settings
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883
MQTT_TELEMETRY_TOPIC=factory/+/telemetry

# API Settings
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Dashboard Settings
DASHBOARD_PORT=8501

